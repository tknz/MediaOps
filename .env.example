APP_NAME=MediaOps
BASE_URL=http://localhost:8000
# Required for startup. Use a long random value; example:
# openssl rand -hex 32
SECRET_KEY=
CONFIG_FILE=/config/config.env

# DATABASE_URL overrides the friendly DB_* fields below when set.
# DATABASE_URL=postgresql+psycopg://mediaops:<db-password>@db:5432/mediaops
DB_HOST=db
DB_PORT=5432
DB_NAME=mediaops
DB_USER=mediaops
DB_PASSWORD=
DB_SSLMODE=

PLEX_CLIENT_ID=mediaops
PLEX_PRODUCT=MediaOps
PLEX_SERVER_URL=
PLEX_SERVER_TOKEN=
PLEX_OWNER_ID=

# Allows first-run service setup before Plex auth is connected.
SETUP_NO_AUTH=true
SETUP_USER=setup
LOCAL_AUTH_USERNAME=
LOCAL_AUTH_PASSWORD_HASH=

SEERR_URL=
SEERR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
SABNZBD_URL=
SABNZBD_API_KEY=
TAUTULLI_URL=
TAUTULLI_API_KEY=

# Optional one-time legacy/bootstrap imports. Leave blank for normal installs.
# IMPORT_TAUTULLI_DB=/imports/tautulli.db
# IMPORT_SEERR_DB=/imports/seerr.db
# IMPORT_RADARR_DB=/imports/radarr.db
# IMPORT_SONARR_DB=/imports/sonarr.db

SYNC_INTERVAL_MINUTES=60

# Advanced optional endpoints. Leave blank for normal browser use.
# PLEX_WEBHOOK_TOKEN enables the optional Plex webhook endpoint.
PLEX_WEBHOOK_TOKEN=
# API_* tokens are for automation clients calling the JSON API.
API_ADMIN_TOKEN=
API_TOKENS=
