APP_NAME=MediaOps
BASE_URL=http://localhost:8000
SECRET_KEY=replace-me-with-a-long-random-value
CONFIG_FILE=/config/config.json

# DATABASE_URL overrides the friendly DB_* fields below when set.
# DATABASE_URL=postgresql+psycopg://mediaops:mediaops@db:5432/mediaops
DB_HOST=db
DB_PORT=5432
DB_NAME=mediaops
DB_USER=mediaops
DB_PASSWORD=mediaops
DB_SSLMODE=

PLEX_CLIENT_ID=mediaops
PLEX_PRODUCT=MediaOps
PLEX_SERVER_URL=
PLEX_SERVER_TOKEN=
PLEX_OWNER_ID=

# Allows first-run service setup before Plex auth is connected.
SETUP_NO_AUTH=true
SETUP_USER=setup

SEERR_URL=
SEERR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
SABNZBD_URL=
SABNZBD_API_KEY=
TAUTULLI_URL=
TAUTULLI_API_KEY=

IMPORT_TAUTULLI_DB=/imports/tautulli.db
IMPORT_SEERR_DB=/imports/seerr.db
IMPORT_RADARR_DB=/imports/radarr.db
IMPORT_SONARR_DB=/imports/sonarr.db

SYNC_INTERVAL_MINUTES=60
DEV_BYPASS_AUTH=false
DEV_USER=admin
API_ADMIN_TOKEN=
API_TOKENS=
